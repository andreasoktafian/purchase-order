<configuration>
    <conversionRule conversionWord="maskedUserId"
                    converterClass="andreas.purchaseorder.utilities.MaskedUserIdConverter" />

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%X{correlationId}] [User: %maskedUserId] --- %-40.40logger{39} : %m%n%wEx</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="andreas.purchaseorder" level="INFO" />
</configuration>